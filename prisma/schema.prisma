}

model ResearchSource {
  id                        String                      @id
  key                       String                      @unique
  title                     String
  sourceType                ResearchSourceType
  status                    ResearchSourceStatus        @default(PENDING)
  artifactPath              String?
  notes                     String?
  publishedAt               DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  ProductCapabilityMap      ProductCapabilityMap[]
  ProductSignal             ProductSignal[]
  ProductTaxonomyAssignment ProductTaxonomyAssignment[]
  TaxonomyBucketCapability  TaxonomyBucketCapability[]
  VendorSignal              VendorSignal[]
}

model TaxonomyBucket {
  id                        String                      @id
  key                       String                      @unique
  title                     String
  description               String?
  kind                      TaxonomyBucketKind
  parentId                  String?
  active                    Boolean                     @default(true)
  verticalId                String                      @default("accounting")
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
