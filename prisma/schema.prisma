// =========================================================
// Agent system tables (Phase 0)
// See PATALIGN-AGENT-PHASE-1-IMPL-SPEC.md §2. The supervisor process
// (scripts/agents/supervisor.ts) syncs AgentDefinition rows from agents/*.yaml,
// records each invocation as an AgentRun, and writes every hook event to
// AgentAuditLogEntry. AgentApproval backs the Phase 1d Telegram round-trip.
// verticalId carries the future Vertical Pack key; defaults to "accounting".
// =========================================================

model AgentDefinition {
  id          String          @id @default(cuid())
  key         String          @unique // e.g. "qa-smoke", "pilot-ops", "cloudflare-watcher"
  name        String // human-readable
  description String?
  enabled     Boolean         @default(true)
  configYaml  String // serialized YAML config (model, tools, hard caps, cadence)
  verticalId  String          @default("accounting") // vertical pack key (future cross-industry)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  runs        AgentRun[]
  approvals   AgentApproval[]

  @@index([key])
  @@index([verticalId])
}

model AgentRun {
  id            String               @id @default(cuid())
  agentKey      String // FK shape (denormalized for query speed)
  agent         AgentDefinition      @relation(fields: [agentKey], references: [key])
  trigger       String // "scheduled" | "manual" | "approval-resume" | "test"
  triggerSource String? // user id, scheduler name, etc.
  status        AgentRunStatus       @default(running)
  startedAt     DateTime             @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  tokensInput   Int?
  tokensOutput  Int?
  estCostUsd    Decimal?             @db.Decimal(10, 6)
  finalSummary  String? // short markdown summary
  errorClass    String? // structured failure category
  errorMessage  String?
  steps         AgentStep[]
  auditLog      AgentAuditLogEntry[]
  approvals     AgentApproval[]

  @@index([agentKey, startedAt(sort: Desc)])
  @@index([status])
}

enum AgentRunStatus {
  running
  awaiting_approval
  completed
  failed
  cancelled
  timeout
  budget_exceeded
  circuit_open
}

model AgentStep {
  id           String    @id @default(cuid())
  runId        String
  run          AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepIdx      Int // monotonic within run
  kind         String // "thought" | "tool_call" | "tool_result" | "approval_request" | "approval_granted" | "approval_denied" | "summary"
  toolName     String?
  toolArgs     Json?
  toolResult   Json?
  modelUsed    String? // "claude-sonnet-4-6", "claude-haiku-4-5", etc.
  tokensInput  Int?
  tokensOutput Int?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([runId, stepIdx])
}

model AgentAuditLogEntry {
  id        String    @id @default(cuid())
  runId     String?
  run       AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  agentKey  String?
  hookPhase String // "pre_tool_use" | "post_tool_use" | "can_use_tool" | "user_message" | "agent_message" | "approval_decision"
  payload   Json
  outcome   String? // "allowed" | "blocked" | "approved" | "denied" | "edited" | "error"
  createdAt DateTime  @default(now())

  @@index([agentKey, createdAt(sort: Desc)])
  @@index([runId])
  @@index([hookPhase])
}

model AgentApproval {
  id             String              @id @default(cuid())
  runId          String
  run            AgentRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  agentKey       String
  agent          AgentDefinition     @relation(fields: [agentKey], references: [key])
  proposedAction String // "send_email" | "post_forum" | "provision_user" | etc.
  proposedArgs   Json
  rationale      String? // agent's explanation
  blastRadius    String? // "low" | "medium" | "high"
  estCostUsd     Decimal?            @db.Decimal(10, 6)
  status         AgentApprovalStatus @default(pending)
  decidedBy      String? // operator email / chat id
  decidedAt      DateTime?
  decision       String? // "approve" | "deny" | "edit"
  editedArgs     Json? // when decision = "edit", what the operator changed to
  decisionNote   String?
  telegramMsgId  String? // for inline button updates
  telegramHmac   String? // anti-replay
  createdAt      DateTime            @default(now())

  @@index([status, createdAt])
  @@index([agentKey])
  @@index([runId])
}

enum AgentApprovalStatus {
  pending
  approved
  denied
  edited
  expired
  cancelled
}

// Per-agent key/value state store. Runtime plumbing (like AgentRun/audit), not a
// tool: agents persist baselines here between runs (e.g. the Cloudflare watcher's
// last-known DNS snapshot) via lib/agents/state.ts. Not production business data.
model AgentState {
  id        String   @id @default(cuid())
  agentKey  String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentKey, key])
  @@index([agentKey])
}

// Production trigger queue (Phase 2.5 #5). The Vercel-served /admin command bar
// cannot spawn agent processes (agents run on the Mac mini supervisor), so the
// run endpoint enqueues a row here and the supervisor polls + claims it.
// taskEnv carries the parsed per-run env overrides (PAT_PILOT_TASK,
// PAT_PILOT_FIRM, PAT_KNOWLEDGE_QUERY) as a plain JSON object.
model AgentTriggerRequest {
  id          String             @id @default(cuid())
  agentKey    String
  message     String?
  taskEnv     Json?
  requestedBy String? // admin user email/id from the session
  status      AgentTriggerStatus @default(pending)
  createdAt   DateTime           @default(now())
  claimedAt   DateTime?
  finishedAt  DateTime?
  runId       String? // AgentRun id once the supervisor starts the run
  error       String?

  @@index([status, createdAt])
  @@index([agentKey, createdAt(sort: Desc)])
}

enum AgentTriggerStatus {
  pending
  claimed
  completed
  failed
  expired
}

// Internal Knowledge corpus (Phase 2 #2). Zero-dependency lexical search:
// KnowledgeChunk has a generated tsvector column ("tsv") + GIN index created in
// the migration SQL (omitted here — DB-generated, never written via Prisma;
// queried via $queryRaw). Vector RAG (pgvector) is the future upgrade — see
// docs/agents/internal-knowledge.md. verticalId is carried for future per-vertical
// knowledge; v1 retrieval is cross-vertical (operational knowledge).
model KnowledgeSource {
  id            String              @id @default(cuid())
  kind          KnowledgeSourceKind
  path          String              @unique
  contentHash   String
  lastIndexedAt DateTime
  verticalId    String              @default("accounting")
  // Customer-facing scoping for help_doc sources. Empty array = visible to every
  // authenticated portal audience; otherwise lists the audiences allowed to
  // retrieve these chunks (e.g. ["vendor"], ["firm","consultant"]). Enforced in
  // the SQL WHERE of lib/patAssistant/retrieveHelp.ts — never by prompting.
  roleAccess    String[]            @default([])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  chunks        KnowledgeChunk[]

  @@index([kind])
  @@index([verticalId])
}

enum KnowledgeSourceKind {
  repo_doc
  audit_log
  dream_state
  help_doc
}

model KnowledgeChunk {
  id        String          @id @default(cuid())
  sourceId  String
  source    KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunkIdx  Int
  text      String
  tokens    Int
  createdAt DateTime        @default(now())

  @@index([sourceId, chunkIdx])
}

// Block 3 (2026-06-11): cached agent-written executive narratives for
// /admin/reports. One row per report; regenerated only when the underlying
// computed payload's fingerprint changes (cost guard — re-renders never
// re-call the API). The narrative is derived display copy, never evidence.
model ReportNarrative {
  id              String   @id @default(cuid())
  reportKey       String   @unique
  dataFingerprint String
  narrative       String
  model           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── Pat notification / ping system (Phase 0 foundation, 2026-06-18) ────────────
// Additive + flag-gated. Renders nothing until PAT_ENABLE_PINGS=1. See
// lib/notifications/ (Phase B) and the ping-system design doc. The in-app
// notification center reads Notification; NotificationDelivery tracks per-channel
// fan-out; NotificationPreference is the per-user preference center / cadence
// governor input; NudgeEvent is the user-facing audit log (mirrors
// OperatorAuditEvent). EngagementQuarter carries the quarterly completion target
// that deadline-based reminders fire against.

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

enum DigestFrequency {
  OFF
  DAILY
  WEEKLY
}

model Notification {
  id              String                 @id @default(cuid())
  recipientUserId String
  recipient       User                   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  audience        String
  kind            String
  title           String
  body            String
  ctaLabel        String?
  ctaHref         String?
  // Trigger source for dedupe + re-surfacing (e.g. sourceType="SurveyModule").
  sourceType      String?
  sourceId        String?
  // Who triggered it; null = automated/system nudge.
  actorUserId     String?
  readAt          DateTime?
  createdAt       DateTime               @default(now())
  deliveries      NotificationDelivery[]

  // One live notification per (recipient, source, kind) — the dedupe key that
  // stops double-sends for the same stalled task.
  @@unique([recipientUserId, sourceType, sourceId, kind])
  @@index([recipientUserId, readAt])
  @@index([audience])
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String
  notification   Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  sentAt         DateTime?
  error          String?
  createdAt      DateTime                   @default(now())

  @@unique([notificationId, channel])
  @@index([status])
}

model NotificationPreference {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  inAppEnabled    Boolean         @default(true)
  emailEnabled    Boolean         @default(true)
  quietHoursStart Int?            // minutes from local midnight, e.g. 1320 = 22:00
  quietHoursEnd   Int?            // minutes from local midnight, e.g. 480 = 08:00
  timezone        String          @default("America/New_York")
  digestFrequency DigestFrequency @default(OFF)
  // Per-kind opt-outs: { "CONSULTANT_FIRM_NUDGE": false, ... }
  kindOptOuts     Json            @default("{}")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// Opt-in consent for the customer-facing Pat AI assistant (Elite Sprint Block A,
// 2026-07-07). Default OFF: absence of a row — or optedIn=false — means Pat does
// not render and /api/pat returns 404. One row per user; the toggle only governs
// the AI assistant, never platform data (that lives under the ToS/Privacy Policy).
model AiAssistantConsent {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  optedIn        Boolean   @default(false)
  consentVersion String?
  grantedAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model NudgeEvent {
  id              String   @id @default(cuid())
  actorUserId     String?
  recipientUserId String
  kind            String
  sourceType      String?
  sourceId        String?
  manual          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([recipientUserId, createdAt])
  @@index([actorUserId, createdAt])
}

model EngagementQuarter {
  id               String   @id @default(cuid())
  companyId        String
  // Quarter label, e.g. "2026-Q3".
  quarter          String
  // Target completion (0–100) of assessment modules by quarter end — the bar for
  // "good data" that deadline reminders push elite-tier firms/vendors toward.
  targetPercent    Int      @default(100)
  dueDate          DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, quarter])
  @@index([dueDate])
}

// ---------------------------------------------------------------------------
// Adaptive firm modules (Sprint 4 M1, 2026-07-08).
// Per PATALIGN-ADAPTIVE-MODULES-SPEC + PATALIGN-MODULE-METHODOLOGY-OUTLINE.
// Hard rules baked into the schema:
//   1. Every ModuleItem MUST carry >= 1 ModuleSource (sourced-content bar) —
//      enforced by lib/modules/serving.ts + contract tests. "Tier C does not
//      exist": no scraped/unlicensed/unsourced content ever serves.
//   2. A ModuleTemplate serves to customers ONLY when reviewStatus = APPROVED
//      (two-signature publish gate: CPA accuracy + clarity). Nothing serves
//      until the CPA-certified founder flips the status.
// All additive; dark until wired to surfaces in a later phase.
// ---------------------------------------------------------------------------

model ModuleTemplate {
  id                String             @id @default(cuid())
  key               String             @unique
  category          String
  // Scoring-pattern subset this module is authored for (AAE pattern discipline).
  targetPattern     String
  moduleType        ModuleType
  title             String
  // Measurable learning objectives (>= 75% must be measured by the assessment).
  objectives        Json?
  reviewStatus      ModuleReviewStatus @default(DRAFT)
  // Two-signature publish gate (methodology redline, locked 2026-07-08):
  // CPA-certified founder signs content accuracy; clarity reviewer (Leslie)
  // signs readability. APPROVED requires both.
  cpaReviewedBy     String?
  cpaReviewedAt     DateTime?
  clarityReviewedBy String?
  clarityReviewedAt DateTime?
  verticalId        String             @default("accounting")
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  ModuleItem        ModuleItem[]
  ModuleUnlockRule  ModuleUnlockRule[]

  @@index([category])
  @@index([moduleType, reviewStatus])
  @@index([verticalId])
}

model ModuleItem {
  id                 String           @id @default(cuid())
  key                String           @unique
  templateId         String
  category           String
  itemKind           ModuleItemKind
  difficulty         ModuleDifficulty
  // Anchor items appear unchanged for every firm — the cross-firm benchmark
  // thread that keeps scores comparable while the rest of the bank rotates.
  isAnchor           Boolean          @default(false)
  stem               String
  // Answer choices: array of { key, label }.
  choices            Json
  correctKey         String
  // Per-choice rationale — why wrong answers are wrong, per QAS feedback rule.
  feedback           Json?
  // Calibration placeholders until real sitting data accrues (methodology §6):
  // discrimination = do high scorers get it right more than low scorers.
  discriminationSeed Float            @default(0.3)
  pValueSeed         Float?
  order              Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  ModuleTemplate     ModuleTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ModuleSource       ModuleSource[]

  @@index([templateId, itemKind])
  @@index([category])
  @@index([difficulty])
}

model ModuleSource {
  id          String              @id @default(cuid())
  itemId      String
  sourceOrg   String
  sourceDoc   String
  sourceUrl   String?
  licenseType ModuleSourceLicense
  accessedAt  DateTime
  createdAt   DateTime            @default(now())
  ModuleItem  ModuleItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([licenseType])
}

model ModuleUnlockRule {
  id             String         @id @default(cuid())
  // Scoring-pattern subset key that triggers this unlock.
  patternSubset  String
  templateId     String
  // Quarters after the trigger before the module opens (EngagementQuarter drip).
  quarterOffset  Int            @default(0)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  ModuleTemplate ModuleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([patternSubset, templateId])
  @@index([templateId])
}

enum ModuleType {
  DIAGNOSTIC
  STRENGTH
  REMEDIATION
}

enum ModuleReviewStatus {
  DRAFT
  CLARITY_REVIEW
  CPA_REVIEW
  APPROVED
  RETIRED
}

enum ModuleItemKind {
  ENTRY
  REVIEW
  FINAL
}

enum ModuleDifficulty {
  EASY
  MODERATE
  HARD
}

enum ModuleSourceLicense {
  PUBLIC_DOMAIN
  CITED
  LICENSED
}
