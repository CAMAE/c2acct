generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Badge {
  id                String              @id
  name              String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  BadgeRule         BadgeRule[]
  CompanyBadge      CompanyBadge[]
  InsightUnlockRule InsightUnlockRule[]
}

model BadgeRule {
  id           String       @id
  badgeId      String
  moduleId     String
  minScore     Float?
  required     Boolean      @default(true)
  Badge        Badge        @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  SurveyModule SurveyModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([badgeId, moduleId])
  @@index([badgeId])
  @@index([moduleId])
}

model BenchmarkCohort {
  id                     String                   @id
  key                    String                   @unique
  title                  String
  companyType            CompanyType
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  BenchmarkRun           BenchmarkRun[]
  CompanyBenchmark       CompanyBenchmark[]
  CompanyBenchmarkCohort CompanyBenchmarkCohort[]
}

model BenchmarkRun {
  id              String          @id
  cohortId        String
  metricKey       String
  version         Int             @default(1)
  n               Int             @default(0)
  mean            Float           @default(0)
  stdev           Float?
  p10             Float?
  p25             Float?
  p50             Float?
  p75             Float?
  p90             Float?
  computedAt      DateTime        @default(now())
  BenchmarkCohort BenchmarkCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, metricKey, version])
  @@index([cohortId])
  @@index([metricKey])
}

model CapabilityEdge {
  id                                                   String         @id
  fromId                                               String
  toId                                                 String
  type                                                 String?
  weight                                               Float          @default(1.0)
  createdAt                                            DateTime       @default(now())
  CapabilityNode_CapabilityEdge_fromIdToCapabilityNode CapabilityNode @relation("CapabilityEdge_fromIdToCapabilityNode", fields: [fromId], references: [id], onDelete: Cascade)
  CapabilityNode_CapabilityEdge_toIdToCapabilityNode   CapabilityNode @relation("CapabilityEdge_toIdToCapabilityNode", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([fromId])
  @@index([toId])
}

model CapabilityNode {
  id                                                   String                     @id
  key                                                  String                     @unique
  title                                                String
  description                                          String?
  scope                                                CapabilityScope
  level                                                CapabilityLevel            @default(TIER1)
  weight                                               Float                      @default(1.0)
  active                                               Boolean                    @default(true)
  createdAt                                            DateTime                   @default(now())
  updatedAt                                            DateTime
  CapabilityEdge_CapabilityEdge_fromIdToCapabilityNode CapabilityEdge[]           @relation("CapabilityEdge_fromIdToCapabilityNode")
  CapabilityEdge_CapabilityEdge_toIdToCapabilityNode   CapabilityEdge[]           @relation("CapabilityEdge_toIdToCapabilityNode")
  CompanyCapabilityScore                               CompanyCapabilityScore[]
  InsightCapabilityRule                                InsightCapabilityRule[]
  ModuleCapability                                     ModuleCapability[]
  SurveyQuestionCapability                             SurveyQuestionCapability[]
  TaxonomyBucketCapability                             TaxonomyBucketCapability[]
  ProductCapabilityMap                                 ProductCapabilityMap[]
}

model Company {
  id                     String                   @id
  name                   String
  type                   CompanyType
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  CompanyBadge           CompanyBadge[]
  CompanyBenchmark       CompanyBenchmark[]
  CompanyBenchmarkCohort CompanyBenchmarkCohort[]
  CompanyCapabilityScore CompanyCapabilityScore[]
  FirmMaturityIndex      FirmMaturityIndex[]
  FirmMaturityMomentum   FirmMaturityMomentum[]
  FirmMaturitySnapshot   FirmMaturitySnapshot[]
  Product                Product[]
  ConsultantAssignment   ConsultantAssignment[]
  Subject                Subject?
  SurveySubmission       SurveySubmission[]
  User                   User[]
  VendorProfile          VendorProfile?
}

model CompanyBadge {
  id        String   @id
  companyId String
  subjectId String?
  badgeId   String
  moduleId  String
  awardedAt DateTime @default(now())
  Badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  Company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  Subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([companyId, badgeId, moduleId])
  @@index([badgeId])
  @@index([companyId])
  @@index([subjectId])
}

model CompanyBenchmark {
  id              String          @id
  companyId       String
  cohortId        String
  metricKey       String
  version         Int             @default(1)
  score           Float           @default(0)
  percentile      Float           @default(0)
  computedAt      DateTime        @default(now())
  BenchmarkCohort BenchmarkCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  Company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, cohortId, metricKey, version])
  @@index([cohortId])
  @@index([companyId])
}

model CompanyBenchmarkCohort {
  id              String          @id
  companyId       String
  cohortId        String
  createdAt       DateTime        @default(now())
  BenchmarkCohort BenchmarkCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  Company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, cohortId])
  @@index([cohortId])
  @@index([companyId])
}

model CompanyCapabilityScore {
  id             String         @id
  companyId      String
  nodeId         String
  score          Float
  scoreVersion   Int            @default(1)
  computedAt     DateTime       @default(now())
  Company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  CapabilityNode CapabilityNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([companyId, nodeId, scoreVersion])
  @@index([companyId])
  @@index([nodeId])
}

model FirmMaturityIndex {
  id         String   @id
  companyId  String
  score      Float
  version    Int      @default(1)
  computedAt DateTime @default(now())
  bandMax    Float    @default(25)
  bandMin    Float    @default(0)
  tier       String   @default("FOUNDATIONAL")
  Company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, version])
  @@index([companyId])
}

model FirmMaturityMomentum {
  id         String   @id
  companyId  String
  version    Int      @default(1)
  windowN    Int      @default(3)
  delta1     Float    @default(0)
  delta2     Float    @default(0)
  accel      Float    @default(0)
  avgDelta   Float    @default(0)
  volatility Float    @default(0)
  trend      String   @default("FLAT")
  velocity   String   @default("STABLE")
  stability  String   @default("STABLE")
  computedAt DateTime @default(now())
  Company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, version])
  @@index([companyId])
}

model FirmMaturitySnapshot {
  id         String   @id
  companyId  String
  score      Float
  tier       String
  bandMin    Float
  bandMax    Float
  version    Int      @default(1)
  computedAt DateTime @default(now())
  Company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, computedAt])
  @@index([companyId, version])
}

model Insight {
  id                    String                  @id
  key                   String                  @unique
  title                 String
  body                  String
  tier                  Int                     @default(1)
  active                Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  InsightCapabilityRule InsightCapabilityRule[]
  InsightUnlockRule     InsightUnlockRule[]
}

model InsightCapabilityRule {
  id             String         @id
  insightId      String
  nodeId         String
  minScore       Float
  required       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  Insight        Insight        @relation(fields: [insightId], references: [id], onDelete: Cascade)
  CapabilityNode CapabilityNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([insightId, nodeId])
  @@index([insightId])
  @@index([nodeId])
}

model InsightUnlockRule {
  id        String   @id
  insightId String
  badgeId   String
  required  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Insight   Insight  @relation(fields: [insightId], references: [id], onDelete: Cascade)
  Badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([insightId, badgeId])
  @@index([insightId])
  @@index([badgeId])
}

model ModuleCapability {
  id             String         @id
  moduleId       String
  nodeId         String
  weight         Float          @default(1.0)
  createdAt      DateTime       @default(now())
  SurveyModule   SurveyModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  CapabilityNode CapabilityNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([moduleId, nodeId])
  @@index([moduleId])
  @@index([nodeId])
}

model Product {
  id                        String                      @id
  companyId                 String?
  vendorId                  String?
  name                      String
  slug                      String?                     @unique
  category                  String?
  website                   String?
  summary                   String?
  apiEndpoint               String?
  deploymentModel           ProductDeploymentModel?
  active                    Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  Company                   Company?                    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  Subject                   Subject?
  ProductAssessmentPlan     ProductAssessmentPlan[]
  ProductProfile            ProductProfile?
  Vendor                    VendorProfile?              @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  ProductCapabilityMap      ProductCapabilityMap[]
  ProductSignal             ProductSignal[]
  ProductTaxonomyAssignment ProductTaxonomyAssignment[]

  @@index([companyId])
  @@index([vendorId])
}

model ProductProfile {
  id                  String   @id
  productId           String   @unique
  logoUrl             String?
  logoAssetRef        String?
  positioning         String?
  targetCustomer      String?
  targetUseContext    String?
  implementationStyle String?
  operatingModelFit   String?
  primaryBuyer        String?
  integrationPosture  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  Product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductAssessmentPlan {
  id                   String                       @id
  productId            String
  perspective          ProductAssessmentPerspective
  registryVersion      String
  selectedUtilityKeys  String[]
  generatedQuestionIds String[]
  profileQuestionIds   String[]
  scoredQuestionIds    String[]
  openEndedQuestionIds String[]
  moduleOrder          String[]
  sectionOrder         String[]
  modulePlan           Json
  sectionPlan          Json
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  Product              Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, perspective])
  @@index([perspective])
  @@index([productId])
}

model Portal {
  id          String       @id
  key         String       @unique
  title       String
  subjectKind SubjectKind?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Subject {
  id                     String                   @id
  key                    String                   @unique
  displayName            String
  kind                   SubjectKind
  companyId              String?                  @unique
  productId              String?                  @unique
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  Company                Company?                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  BillingCustomer        BillingCustomer[]
  BillingInvoice         BillingInvoice[]
  MembershipSubscription MembershipSubscription[]
  Product                Product?                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  CompanyBadge           CompanyBadge[]
  SubjectMembership      SubjectMembership[]
  SurveySubmission       SurveySubmission[]
  VendorProfile          VendorProfile?
}

model MembershipSubscription {
  id                      String           @id
  subjectId               String
  plan                    MembershipPlan
  status                  MembershipStatus
  provider                String?
  externalCustomerRef     String?
  externalSubscriptionRef String?
  providerPriceRef        String?
  providerStatus          String?
  providerCancelAtPeriodEnd Boolean        @default(false)
  checkoutSessionRef      String?
  checkoutRequestedPlan   MembershipPlan?
  startedAt               DateTime?
  trialEndsAt             DateTime?
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  canceledAt              DateTime?
  lastBillingEventType    String?
  lastBillingEventAt      DateTime?
  lastWebhookEventId      String?
  lastReconciledAt        DateTime?
  paymentActionRequiredAt DateTime?
  metadata                Json?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  Subject                 Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId])
  @@index([plan, status])
  @@index([subjectId, status])
  @@index([provider, externalCustomerRef])
  @@index([provider, externalSubscriptionRef])
}

model BillingCustomer {
  id                 String   @id
  subjectId          String
  provider           String
  providerCustomerId String
  email              String?
  name               String?
  metadata           Json?
  lastSyncedAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  Subject            Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, provider])
  @@unique([provider, providerCustomerId])
  @@index([subjectId])
}

model BillingWebhookEvent {
  id              String    @id
  provider        String
  providerEventId String
  eventType       String
  apiVersion      String?
  livemode        Boolean   @default(false)
  payload         Json
  processingStatus String   @default("received")
  processingError String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([provider, providerEventId])
  @@index([provider, eventType, createdAt])
  @@index([processingStatus, createdAt])
}

model BillingInvoice {
  id                         String   @id
  subjectId                  String?
  provider                   String
  providerInvoiceId          String
  providerCustomerId         String?
  providerSubscriptionId     String?
  status                     String
  amountDue                  Int?
  amountPaid                 Int?
  currency                   String?
  hostedInvoiceUrl           String?
  invoicePdf                 String?
  paymentIntentRef           String?
  lastPaymentError           String?
  raw                        Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  Subject                    Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([provider, providerInvoiceId])
  @@index([subjectId])
  @@index([provider, providerSubscriptionId])
  @@index([provider, providerCustomerId])
  @@index([status, updatedAt])
}

model VendorProfile {
  id             String               @id
  key            String               @unique
  displayName    String
  companyId      String?              @unique
  subjectId      String?              @unique
  website        String?
  status         VendorStatus         @default(ACTIVE)
  researchStatus ResearchSourceStatus @default(PENDING)
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  Company        Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  Subject        Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  Product        Product[]
  VendorSignal   VendorSignal[]
}

model ResearchSource {
  id                        String                      @id
  key                       String                      @unique
  title                     String
  sourceType                ResearchSourceType
  status                    ResearchSourceStatus        @default(PENDING)
  artifactPath              String?
  notes                     String?
  publishedAt               DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  ProductCapabilityMap      ProductCapabilityMap[]
  ProductSignal             ProductSignal[]
  ProductTaxonomyAssignment ProductTaxonomyAssignment[]
  TaxonomyBucketCapability  TaxonomyBucketCapability[]
  VendorSignal              VendorSignal[]
}

model TaxonomyBucket {
  id                        String                      @id
  key                       String                      @unique
  title                     String
  description               String?
  kind                      TaxonomyBucketKind
  parentId                  String?
  active                    Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  Parent                    TaxonomyBucket?             @relation("TaxonomyBucketTree", fields: [parentId], references: [id], onDelete: SetNull)
  Children                  TaxonomyBucket[]            @relation("TaxonomyBucketTree")
  ProductTaxonomyAssignment ProductTaxonomyAssignment[]
  TaxonomyBucketCapability  TaxonomyBucketCapability[]

  @@index([kind])
  @@index([parentId])
}

model ProductTaxonomyAssignment {
  id         String             @id
  productId  String
  bucketId   String
  fit        ProductTaxonomyFit @default(PRIMARY)
  confidence ResearchConfidence @default(UNKNOWN)
  sourceId   String?
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  Product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  Bucket     TaxonomyBucket     @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  Source     ResearchSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([productId, bucketId])
  @@index([bucketId, fit])
  @@index([sourceId])
}

model TaxonomyBucketCapability {
  id             String                    @id
  bucketId       String
  nodeId         String?
  capabilityKey  String
  coverage       ProductCapabilityCoverage @default(SUPPORTING)
  confidence     ResearchConfidence        @default(UNKNOWN)
  sourceId       String?
  notes          String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  Bucket         TaxonomyBucket            @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  CapabilityNode CapabilityNode?           @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  Source         ResearchSource?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([bucketId, capabilityKey])
  @@index([nodeId])
  @@index([sourceId])
}

model ProductCapabilityMap {
  id             String                    @id
  productId      String
  nodeId         String?
  capabilityKey  String
  coverage       ProductCapabilityCoverage @default(CORE)
  confidence     ResearchConfidence        @default(UNKNOWN)
  sourceId       String?
  notes          String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  Product        Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  CapabilityNode CapabilityNode?           @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  Source         ResearchSource?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([productId, capabilityKey])
  @@index([nodeId])
  @@index([sourceId])
}

model VendorSignal {
  id          String             @id
  vendorId    String
  signalKey   String
  valueText   String?
  valueNumber Float?
  confidence  ResearchConfidence @default(UNKNOWN)
  sourceId    String?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  Vendor      VendorProfile      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  Source      ResearchSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([vendorId, signalKey])
  @@index([sourceId])
}

model ProductSignal {
  id          String             @id
  productId   String
  signalKey   String
  valueText   String?
  valueNumber Float?
  confidence  ResearchConfidence @default(UNKNOWN)
  sourceId    String?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  Product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  Source      ResearchSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([productId, signalKey])
  @@index([sourceId])
}

model SubjectMembership {
  id             String                @id
  subjectId      String
  userId         String
  membershipRole SubjectMembershipRole @default(MEMBER)
  isPrimary      Boolean               @default(false)
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  Subject        Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  User           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subjectId, userId])
  @@index([subjectId, active])
  @@index([userId, active, isPrimary])
}

model SurveyModule {
  id               String             @id
  key              String             @unique
  title            String
  description      String?
  scope            ModuleScope
  version          Int                @default(1)
  weight           Float              @default(1.0)
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  BadgeRule        BadgeRule[]
  ModuleCapability ModuleCapability[]
  SurveySection    SurveySection[]
  SurveyQuestion   SurveyQuestion[]
  SurveySubmission SurveySubmission[]
}

model SurveySection {
  id               String           @id
  moduleId         String
  key              String
  title            String
  description      String?
  order            Int
  utilityFamily    String?
  utilityKey       String?
  utilityLabel     String?
  subcategoryKey   String?
  subcategoryTitle String?
  basisKey         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  SurveyModule     SurveyModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  SurveyQuestion   SurveyQuestion[]

  @@unique([moduleId, key])
  @@index([moduleId, order])
}

model SurveyQuestion {
  id                       String                     @id
  moduleId                 String
  sectionId                String?
  key                      String
  prompt                   String
  inputType                QuestionInputType
  weight                   Float                      @default(1.0)
  order                    Int
  required                 Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  meta                     Json?
  updatedAt                DateTime
  SurveyModule             SurveyModule               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  SurveySection            SurveySection?             @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  SurveyQuestionCapability SurveyQuestionCapability[]

  @@unique([moduleId, key])
  @@index([moduleId, order])
  @@index([sectionId, order])
}

model SurveyQuestionCapability {
  id             String         @id
  questionId     String
  nodeId         String
  weight         Float          @default(1.0)
  createdAt      DateTime       @default(now())
  CapabilityNode CapabilityNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  SurveyQuestion SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, nodeId])
  @@index([nodeId])
  @@index([questionId])
}

model SurveySubmission {
  id                   String       @id
  version              Int          @default(1)
  answers              Json
  score                Int          @default(0)
  signalIntegrityScore Float        @default(1.0)
  integrityFlags       Json?
  createdAt            DateTime     @default(now())
  moduleId             String
  companyId            String
  subjectId            String?
  scoreVersion         Int          @default(1)
  weightedAvg          Float?
  answeredCount        Int          @default(0)
  scaleMax             Int          @default(100)
  scaleMin             Int          @default(0)
  totalWeight          Float        @default(0)
  Company              Company      @relation(fields: [companyId], references: [id])
  Subject              Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  SurveyModule         SurveyModule @relation(fields: [moduleId], references: [id])

  @@index([companyId, moduleId, createdAt])
  @@index([subjectId, moduleId, createdAt])
}

model User {
  id                String              @id
  email             String              @unique
  name              String?
  role              UserRole            @default(MEMBER)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  companyId         String?
  Company           Company?            @relation(fields: [companyId], references: [id])
  ConsultantProfile ConsultantProfile?
  OperatorAuditEvent OperatorAuditEvent[]
  SubjectMembership SubjectMembership[]

  @@index([companyId])
}

model ConsultantProfile {
  id                   String                 @id
  userId               String                 @unique
  active               Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  User                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ConsultantAssignment ConsultantAssignment[]
}

model ConsultantAssignment {
  id                  String            @id
  consultantProfileId String
  companyId           String
  active              Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  Company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ConsultantProfile   ConsultantProfile @relation(fields: [consultantProfileId], references: [id], onDelete: Cascade)

  @@unique([consultantProfileId, companyId])
  @@index([companyId, active])
  @@index([consultantProfileId, active])
}

model OperatorAuditEvent {
  id         String   @id
  actorUserId String?
  action     String
  entityType String
  entityId   String?
  summary    String
  details    Json?
  createdAt  DateTime @default(now())
  Actor      User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, createdAt])
  @@index([action, createdAt])
}

