  @@index([dataBoundary])
  @@index([startsAt])
}

model PilotCohortMember {
  id                  String                 @id
  cohortId            String
  memberKind          PilotCohortMemberKind
  dataBoundary        DataBoundary           @default(PILOT)
  provisioningState   PilotProvisioningState @default(INVITED)
  companyId           String?
  subjectId           String?
  userId              String?
  inviteEmail         String?
  ownerContactName    String?
  ownerContactEmail   String?
  supportContactName  String?
  supportContactEmail String?
  notes               String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  Company             Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  PilotCohort         PilotCohort            @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  Subject             Subject?               @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  User                User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([cohortId])
  @@index([memberKind, dataBoundary])
  @@index([provisioningState])
  @@index([companyId])
  @@index([subjectId])
  @@index([userId])
}

model MembershipSubscription {
  id                      String           @id
  subjectId               String
  plan                    MembershipPlan
  status                  MembershipStatus
  provider                String?
  externalCustomerRef     String?
  externalSubscriptionRef String?
  providerPriceRef        String?
  providerStatus          String?
  providerCancelAtPeriodEnd Boolean        @default(false)
  checkoutSessionRef      String?
  checkoutRequestedPlan   MembershipPlan?
  startedAt               DateTime?
  trialEndsAt             DateTime?
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  canceledAt              DateTime?
  lastBillingEventType    String?
  lastBillingEventAt      DateTime?
  lastWebhookEventId      String?
  lastReconciledAt        DateTime?
  paymentActionRequiredAt DateTime?
  metadata                Json?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  Subject                 Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId])
  @@index([plan, status])
  @@index([subjectId, status])
  @@index([provider, externalCustomerRef])
  @@index([provider, externalSubscriptionRef])
}

model BillingCustomer {
  id                 String   @id
  subjectId          String
