  @@unique([provider, providerInvoiceId])
  @@index([subjectId])
  @@index([provider, providerSubscriptionId])
  @@index([provider, providerCustomerId])
  @@index([status, updatedAt])
}

model VendorProfile {
  id             String               @id
  key            String               @unique
  displayName    String
  companyId      String?              @unique
  subjectId      String?              @unique
  website        String?
  status         VendorStatus         @default(ACTIVE)
  researchStatus ResearchSourceStatus @default(PENDING)
  notes          String?
  verticalId     String               @default("accounting")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  Company        Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  Subject        Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
