  category                  String?
  website                   String?
  summary                   String?
  apiEndpoint               String?
  deploymentModel           ProductDeploymentModel?
  active                    Boolean                     @default(true)
  verticalId                String                      @default("accounting")
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  Company                   Company?                    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  Subject                   Subject?
  ProductAssessmentPlan     ProductAssessmentPlan[]
  ProductProfile            ProductProfile?
  Vendor                    VendorProfile?              @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  ProductCapabilityMap      ProductCapabilityMap[]
  ProductSignal             ProductSignal[]
