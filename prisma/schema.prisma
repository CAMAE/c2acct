generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  // native = local macOS dev. The Vercel serverless runtime is Amazon Linux
  // (RHEL-family, OpenSSL 3) — a local `vercel build` on macOS must also emit a
  // Linux engine or the prebuilt deploy 500s with "Database unavailable".
  // rhel-openssl-3.0.x matches Vercel's runtime; debian-openssl-3.0.x is kept as
  // a belt-and-suspenders target.
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Badge {
  id                String              @id
  name              String
  verticalId        String              @default("accounting")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  BadgeRule         BadgeRule[]
  CompanyBadge      CompanyBadge[]
  InsightUnlockRule InsightUnlockRule[]

  @@index([verticalId])
}

model BadgeRule {
  id           String       @id
  badgeId      String
  moduleId     String
  minScore     Float?
  required     Boolean      @default(true)
  verticalId   String       @default("accounting")
  Badge        Badge        @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  SurveyModule SurveyModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([badgeId, moduleId])
  @@index([badgeId])
  @@index([moduleId])
  @@index([verticalId])
}

model BenchmarkCohort {
  id                     String                   @id
  key                    String                   @unique
  title                  String
  companyType            CompanyType
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  BenchmarkRun           BenchmarkRun[]
  CompanyBenchmark       CompanyBenchmark[]
  CompanyBenchmarkCohort CompanyBenchmarkCohort[]
}

model BenchmarkRun {
  id              String          @id
  cohortId        String
  metricKey       String
  version         Int             @default(1)
  n               Int             @default(0)
  mean            Float           @default(0)
  stdev           Float?
  p10             Float?
  p25             Float?
  p50             Float?
  p75             Float?
  p90             Float?
  computedAt      DateTime        @default(now())
  BenchmarkCohort BenchmarkCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, metricKey, version])
  @@index([cohortId])
  @@index([metricKey])
}

model CapabilityEdge {
  id                                                   String         @id
  fromId                                               String
  toId                                                 String
  type                                                 String?
  weight                                               Float          @default(1.0)
  createdAt                                            DateTime       @default(now())
  CapabilityNode_CapabilityEdge_fromIdToCapabilityNode CapabilityNode @relation("CapabilityEdge_fromIdToCapabilityNode", fields: [fromId], references: [id], onDelete: Cascade)
  CapabilityNode_CapabilityEdge_toIdToCapabilityNode   CapabilityNode @relation("CapabilityEdge_toIdToCapabilityNode", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([fromId])
  @@index([toId])
}

model CapabilityNode {
  id                                                   String                     @id
  key                                                  String                     @unique
  title                                                String
  description                                          String?
  scope                                                CapabilityScope
  level                                                CapabilityLevel            @default(TIER1)
  weight                                               Float                      @default(1.0)
  active                                               Boolean                    @default(true)
  createdAt                                            DateTime                   @default(now())
  updatedAt                                            DateTime
  CapabilityEdge_CapabilityEdge_fromIdToCapabilityNode CapabilityEdge[]           @relation("CapabilityEdge_fromIdToCapabilityNode")
  CapabilityEdge_CapabilityEdge_toIdToCapabilityNode   CapabilityEdge[]           @relation("CapabilityEdge_toIdToCapabilityNode")
  CompanyCapabilityScore                               CompanyCapabilityScore[]
  InsightCapabilityRule                                InsightCapabilityRule[]
  ModuleCapability                                     ModuleCapability[]
  SurveyQuestionCapability                             SurveyQuestionCapability[]
  TaxonomyBucketCapability                             TaxonomyBucketCapability[]
  ProductCapabilityMap                                 ProductCapabilityMap[]
}

model Company {
  id                     String                   @id
  name                   String
  type                   CompanyType
  verticalId             String                   @default("accounting")
  // Data-integrity boundary (2026-07-09 audit, CLASS 1). PRODUCTION = real
  // customer data; DEMO = seeded/synthetic (demo-benchmark, demo-expand, local
  // review); PILOT = pilot-cohort. Every cross-entity aggregate filters on this
  // via lib/dataBoundary.ts so demo rows never contaminate customer-facing pools.
  dataBoundary           DataBoundary             @default(PRODUCTION)
  // Soft-delete tombstone (Governance Phase 2, A8/B1). A tenant is first
  // soft-deleted (deletedAt set) — retained for the RETENTION window — then hard
  // purged by scripts/ops/delete-tenant.ts. Read paths must exclude deletedAt rows.
  deletedAt              DateTime?
  deletionReason         String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  CompanyBadge           CompanyBadge[]
  CompanyBenchmark       CompanyBenchmark[]
  CompanyBenchmarkCohort CompanyBenchmarkCohort[]
  CompanyCapabilityScore CompanyCapabilityScore[]
  FirmMaturityIndex      FirmMaturityIndex[]
  FirmMaturityMomentum   FirmMaturityMomentum[]
  FirmMaturitySnapshot   FirmMaturitySnapshot[]
  Product                Product[]
  PilotCohortMember      PilotCohortMember[]
  Subject                Subject?
  SurveySubmission       SurveySubmission[]
  User                   User[]
  VendorProfile          VendorProfile?
  EcosystemAsVendor      Ecosystem?               @relation("EcosystemVendor")
  EcosystemFirm          EcosystemFirm[]          @relation("EcosystemFirmCompany")

  @@index([verticalId])
  @@index([type, dataBoundary])
  @@index([deletedAt])
}

// Deletion receipt (Governance Phase 2, A8). A tombstone that OUTLIVES the tenant
// — deliberately NOT an FK to Company, so the record survives a hard purge. Proves
// what was deleted, when, by whom, with a per-model row-count cascade map and the
// list of external touchpoints (Stripe, Blob, logs) that need manual follow-up.
model TenantDeletionReceipt {
  id                  String    @id
  companyId           String
  companyName         String
  companyType         String
  dataBoundary        String
  requestedBy         String?
  reason              String?
  mode                String    // "soft" | "hard"
  recordCounts        Json      // cascade map: model name -> rows affected
  externalTouchpoints Json      // Stripe/Blob/log manual follow-ups + status
  softDeletedAt       DateTime?
  hardDeletedAt       DateTime?
  createdAt           DateTime  @default(now())

  @@index([companyId, createdAt])
  @@index([mode, createdAt])
}

model CompanyBadge {
  id        String   @id
  companyId String
  subjectId String?
  badgeId   String
  moduleId  String
  awardedAt DateTime @default(now())
  verticalId String  @default("accounting")
  Badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  Company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  Subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([companyId, badgeId, moduleId])
  @@index([badgeId])
  @@index([companyId])
  @@index([subjectId])
  @@index([verticalId])
}

model CompanyBenchmark {
  id              String          @id
  companyId       String
  cohortId        String
  metricKey       String
  version         Int             @default(1)
  score           Float           @default(0)
  percentile      Float           @default(0)
  computedAt      DateTime        @default(now())
  BenchmarkCohort BenchmarkCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  Company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, cohortId, metricKey, version])
  @@index([cohortId])
  @@index([companyId])
}

model CompanyBenchmarkCohort {
  id              String          @id
  companyId       String
  cohortId        String
  createdAt       DateTime        @default(now())
  BenchmarkCohort BenchmarkCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  Company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, cohortId])
  @@index([cohortId])
  @@index([companyId])
}

model CompanyCapabilityScore {
  id             String         @id
  companyId      String
  nodeId         String
  score          Float
  scoreVersion   Int            @default(1)
  computedAt     DateTime       @default(now())
  Company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  CapabilityNode CapabilityNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([companyId, nodeId, scoreVersion])
  @@index([companyId])
  @@index([nodeId])
}

model FirmMaturityIndex {
  id         String   @id
  companyId  String
  score      Float
  version    Int      @default(1)
  computedAt DateTime @default(now())
  bandMax    Float    @default(25)
  bandMin    Float    @default(0)
  tier       String   @default("FOUNDATIONAL")
  Company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, version])
  @@index([companyId])
}

model FirmMaturityMomentum {
  id         String   @id
  companyId  String
  version    Int      @default(1)
  windowN    Int      @default(3)
  delta1     Float    @default(0)
  delta2     Float    @default(0)
  accel      Float    @default(0)
  avgDelta   Float    @default(0)
  volatility Float    @default(0)
  trend      String   @default("FLAT")
  velocity   String   @default("STABLE")
  stability  String   @default("STABLE")
  computedAt DateTime @default(now())
  Company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, version])
  @@index([companyId])
}

model FirmMaturitySnapshot {
  id         String   @id
  companyId  String
  score      Float
  tier       String
  bandMin    Float
  bandMax    Float
  version    Int      @default(1)
  computedAt DateTime @default(now())
  Company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, computedAt])
  @@index([companyId, version])
}

model Insight {
  id                    String                  @id
  key                   String                  @unique
  title                 String
  body                  String
  tier                  Int                     @default(1)
  active                Boolean                 @default(true)
  verticalId            String                  @default("accounting")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  InsightCapabilityRule InsightCapabilityRule[]
  InsightUnlockRule     InsightUnlockRule[]

