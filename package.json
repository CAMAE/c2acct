{
  "name": "c2acct",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbopack": "next dev --turbopack",
    "build": "next build --webpack && node scripts/release/prepare-standalone-runtime.mjs",
    "start": "next start",
    "release:gate": "node scripts/release/validate-source-integrity.mjs --root .",
    "release:smoke": "npm run build",
    "release:prelaunch": "npm run release:smoke && node scripts/release/prelaunch-gate.mjs --root .",
    "lint": "eslint --max-warnings=-1",
    "lint:repo": "eslint app lib prisma scripts --max-warnings=0",
    "lint:test": "eslint app lib prisma scripts tests e2e --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "export:safe": "bash scripts/export-codebase-safe.sh",
    "secrets:scan": "bash scripts/secret-scan-precheck.sh",
    "handoff:checklist": "bash scripts/pre-handoff-checklist.sh",
    "handoff:preflight": "npm run secrets:scan && npm run handoff:checklist",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "npm run db:up && npm run db:wait && npm run prisma:migrate:local && PAT_ENABLE_LOCAL_REVIEW_AUTH=1 npm run seed:baseline && PAT_ENABLE_LOCAL_REVIEW_AUTH=1 npm run seed:pat-runtime && PLAYWRIGHT_PORT=3001 PLAYWRIGHT_BASE_URL=http://127.0.0.1:3001 AUTH_URL=http://127.0.0.1:3001 NEXTAUTH_URL=http://127.0.0.1:3001 PAT_ENABLE_LOCAL_REVIEW_AUTH=1 PAT_LOCAL_REVIEW_PASSWORD=pat-local-review AUTH_SECRET=pat-local-auth-secret playwright test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:recreate": "docker compose down -v && docker compose up -d db && npm run db:wait",
    "db:wait": "node --import tsx scripts/db-wait.ts",
    "check:question-count": "node --import tsx scripts/check-question-count.ts",
    "check:pat-runtime": "node --import tsx scripts/check-pat-runtime-consistency.ts",
    "check:capability-mappings": "node --import tsx scripts/check-capability-mappings.ts",
    "check:launch": "npm run check:pat-runtime && npm run check:capability-mappings",
    "check:repo": "npm run lint:repo && npm run typecheck && npm run build",
    "validate:db": "node --import tsx scripts/validate-db.ts",
    "validate:launch": "node --import tsx scripts/validate-launch.ts",
    "smoke:score-unlock-contract": "node --import tsx scripts/smoke-score-unlock-contract.ts",
    "smoke:firm-modular-runtime": "node --import tsx scripts/smoke-firm-modular-runtime.ts",
    "smoke:capability-write": "node --import tsx scripts/smoke-capability-write.ts",
    "smoke:vendor-alignment-catalog": "node --import tsx scripts/smoke-vendor-alignment-catalog.ts",
    "smoke:vendor-product-signal": "node --import tsx scripts/smoke-vendor-product-signal.ts",
    "smoke:launch": "npm run smoke:score-unlock-contract && npm run smoke:firm-modular-runtime && npm run smoke:capability-write && npm run smoke:vendor-alignment-catalog && npm run smoke:vendor-product-signal",
    "prisma:migrate:local": "node --import tsx scripts/prisma-safe.ts migrate deploy",
    "prisma:migrate:deploy": "node --import tsx scripts/prisma-safe.ts migrate deploy",
    "prisma:db:push": "node --import tsx scripts/prisma-safe.ts db push",
    "seed:baseline": "node --import tsx prisma/seed.ts",
    "seed:pat-runtime": "node --import tsx scripts/seed-pat-runtime.ts",
    "seed:accounting-taxonomy": "node --import tsx scripts/import-accounting-taxonomy.ts --apply",
    "seed:accounting-taxonomy:dry-run": "node --import tsx scripts/import-accounting-taxonomy.ts",
    "ops:mac-mini:status": "bash scripts/mac-mini/status.sh",
    "ops:mac-mini:health": "bash scripts/mac-mini/health-check.sh",
    "ops:mac-mini:launchd:install": "bash scripts/mac-mini/launchd-install.sh",
    "ops:mac-mini:launchd:check": "bash scripts/mac-mini/launchd-check.sh",
    "ops:mac-mini:verify": "bash scripts/mac-mini/nightly-verify.sh",
    "ops:mac-mini:validate-runtime": "bash scripts/mac-mini/validate-runtime-contract.sh --check"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.29",
    "node-fetch": "^2.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "json": "^11.0.0",
    "prisma": "^5.22.0",
    "prisma-erd-generator": "^2.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  }
}
