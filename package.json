{
  "name": "c2acct",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "bootstrap:repo": "bash scripts/bootstrap-repo.sh",
    "dev": "node --import tsx scripts/startup-guard.ts launch --kind dev -- next dev --webpack",
    "dev:proof": "node --import tsx scripts/dev-proof.ts",
    "dev:turbopack": "next dev --turbopack",
    "build": "next build --webpack && node scripts/release/prepare-standalone-runtime.mjs",
    "start": "node --import tsx scripts/startup-guard.ts launch --kind standalone -- node .next/standalone/server.js",
    "start:next": "node --import tsx scripts/startup-guard.ts launch --kind next-start -- next start",
    "release:gate": "node scripts/release/validate-source-integrity.mjs --root .",
    "release:smoke": "pnpm build",
    "release:prelaunch": "pnpm release:smoke && node scripts/release/prelaunch-gate.mjs --root . && node scripts/release/asset-integrity-check.mjs --root . --self-host",
    "asset-integrity": "node scripts/release/asset-integrity-check.mjs --root .",
    "launch:proof": "node scripts/release/generate-launch-proof-bundle.mjs --root . --run-route-smoke",
    "release:promote-known-good": "node scripts/release/promote-known-good.mjs --root .",
    "billing:stripe-proof": "node --import tsx scripts/billing/stripe-roundtrip-proof.ts --fixture",
    "validate:release-surfaces": "pnpm release:prelaunch",
    "lint": "eslint --max-warnings=-1",
    "lint:repo": "eslint app lib prisma scripts --max-warnings=0",
    "lint:test": "eslint app lib prisma scripts tests e2e --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "export:safe": "bash scripts/export-codebase-safe.sh",
    "secrets:scan": "bash scripts/secret-scan-precheck.sh",
    "handoff:checklist": "bash scripts/pre-handoff-checklist.sh",
    "handoff:preflight": "pnpm secrets:scan && pnpm handoff:checklist",
    "audit:pat": "pnpm secrets:scan && pnpm lint:repo && pnpm typecheck && vitest run tests/tenancy-invariant.test.ts tests/demo-benchmark-seed.contract.test.ts",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:e2e": "pnpm db:up && pnpm db:wait && pnpm prisma:migrate:local && PAT_ENABLE_LOCAL_REVIEW_AUTH=1 pnpm seed:baseline && PAT_ENABLE_LOCAL_REVIEW_AUTH=1 pnpm seed:pat-runtime && PLAYWRIGHT_PORT=3001 PLAYWRIGHT_BASE_URL=http://127.0.0.1:3001 AUTH_URL=http://127.0.0.1:3001 NEXTAUTH_URL=http://127.0.0.1:3001 PAT_ENABLE_LOCAL_REVIEW_AUTH=1 PAT_ENABLE_CONSULTANT_ACCESS=1 PAT_LOCAL_REVIEW_PASSWORD=pat-local-review AUTH_SECRET=pat-local-auth-secret playwright test",
    "test:e2e:local-review": "PLAYWRIGHT_PORT=3001 PLAYWRIGHT_BASE_URL=http://127.0.0.1:3001 AUTH_URL=http://127.0.0.1:3001 NEXTAUTH_URL=http://127.0.0.1:3001 PAT_ENABLE_LOCAL_REVIEW_AUTH=1 PAT_ENABLE_CONSULTANT_ACCESS=1 PAT_LOCAL_REVIEW_PASSWORD=pat-local-review AUTH_SECRET=pat-local-auth-secret playwright test ${CI:+--workers=1} e2e/local-review-auth.spec.ts e2e/consultant-flow.spec.ts e2e/alignment-board.spec.ts e2e/sales-card.spec.ts e2e/vendor-assessment-draft.spec.ts e2e/insight-elite-stacking.spec.ts e2e/audience-guard.spec.ts",
    "test:e2e:release-integrity": "PLAYWRIGHT_PORT=3001 PLAYWRIGHT_BASE_URL=http://127.0.0.1:3001 AUTH_URL=http://127.0.0.1:3001 NEXTAUTH_URL=http://127.0.0.1:3001 PAT_ENABLE_LOCAL_REVIEW_AUTH=1 PAT_LOCAL_REVIEW_PASSWORD=pat-local-review AUTH_SECRET=pat-local-auth-secret playwright test e2e/release-integrity.spec.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:recreate": "bash scripts/db-recreate.sh",
    "db:wait": "node --import tsx scripts/db-wait.ts",
    "check:question-count": "node --import tsx scripts/check-question-count.ts",
    "check:pat-runtime": "node --import tsx scripts/check-pat-runtime-consistency.ts",
    "check:capability-mappings": "node --import tsx scripts/check-capability-mappings.ts",
    "check:launch": "pnpm check:pat-runtime && pnpm check:capability-mappings",
    "check:repo": "pnpm lint:repo && pnpm typecheck && pnpm build",
    "validate:db": "node --import tsx scripts/validate-db.ts",
    "validate:launch": "node --import tsx scripts/validate-launch.ts",
    "agent:run": "node --import tsx scripts/agents/run-agent.ts",
    "agent:eval:qa-smoke": "node --import tsx scripts/agents/eval/qa-smoke.ts",
    "agent:eval:cloudflare-watcher": "node --import tsx scripts/agents/eval/cloudflare-watcher.ts",
    "agent:eval:pilot-ops": "node --import tsx scripts/agents/eval/pilot-ops.ts",
    "agent:eval:internal-knowledge": "node --import tsx scripts/agents/eval/internal-knowledge.ts",
    "agent:index-knowledge": "node --import tsx scripts/agents/index-knowledge.ts",
    "telegram-bot": "node --import tsx scripts/agents/telegram-bot.ts",
    "agent:approval-verify": "node --import tsx scripts/agents/telegram-approval-verify.ts",
    "standalone:local": "node --import tsx scripts/local-standalone.ts",
    "standalone:local:check": "node --import tsx scripts/local-standalone.ts --check",
    "smoke:score-unlock-contract": "node --import tsx scripts/smoke-score-unlock-contract.ts",
    "smoke:firm-modular-runtime": "node --import tsx scripts/smoke-firm-modular-runtime.ts",
    "smoke:capability-write": "node --import tsx scripts/smoke-capability-write.ts",
    "smoke:vendor-alignment-catalog": "node --import tsx scripts/smoke-vendor-alignment-catalog.ts",
    "smoke:vendor-product-signal": "node --import tsx scripts/smoke-vendor-product-signal.ts",
    "smoke:launch": "pnpm smoke:score-unlock-contract && pnpm smoke:firm-modular-runtime && pnpm smoke:capability-write && pnpm smoke:vendor-alignment-catalog && pnpm smoke:vendor-product-signal",
    "prisma:generate": "prisma generate --generator client",
    "prisma:migrate:local": "node --import tsx scripts/prisma-safe.ts migrate deploy",
    "prisma:migrate:deploy": "node --import tsx scripts/prisma-safe.ts migrate deploy",
    "prisma:db:push": "node --import tsx scripts/prisma-safe.ts db push",
    "seed:baseline": "node --import tsx prisma/seed.ts",
    "seed:pat-runtime": "node --import tsx scripts/seed-pat-runtime.ts",
    "index:help": "node --import tsx scripts/index-help.ts",
    "compute:benchmarks": "node --import tsx scripts/compute-benchmarks.ts",
    "backfill:firm-maturity": "node --import tsx scripts/backfill-firm-maturity.ts",
    "rollup:firm-maturity": "node --import tsx scripts/rollup-firm-maturity.ts",
    "seed:demo-swaps": "node --import tsx scripts/seed-demo-swaps.ts",
    "seed:help-prod:dry-run": "node --import tsx scripts/seed-help-prod.ts",
    "seed:help-prod": "node --import tsx scripts/seed-help-prod.ts --apply",
    "seed:demo-benchmark": "node --import tsx scripts/seed-demo-benchmark.ts",
    "seed:demo-expand:dry-run": "node --import tsx scripts/demo/expand-demo-ecosystem.ts",
    "seed:demo-expand": "node --import tsx scripts/demo/expand-demo-ecosystem.ts --apply",
    "preview:pat-setup": "node --import tsx scripts/dev/preview-pat-setup.ts",
    "smoke:ask-pat": "node --import tsx scripts/smoke-ask-pat.ts",
    "modules:import-qbank:dry-run": "node --import tsx scripts/modules/import-qbank.ts",
    "modules:import-qbank": "node --import tsx scripts/modules/import-qbank.ts --apply",
    "seed:accounting-taxonomy": "node --import tsx scripts/import-accounting-taxonomy.ts --apply",
    "seed:accounting-taxonomy:dry-run": "node --import tsx scripts/import-accounting-taxonomy.ts",
    "ops:mac-mini:status": "bash scripts/mac-mini/status.sh",
    "ops:mac-mini:health": "bash scripts/mac-mini/health-check.sh",
    "ops:mac-mini:launchd:install": "bash scripts/mac-mini/launchd-install.sh",
    "ops:mac-mini:launchd:check": "bash scripts/mac-mini/launchd-check.sh",
    "ops:mac-mini:stale-port-guide": "bash scripts/mac-mini/stale-port-guidance.sh",
    "ops:mac-mini:verify": "bash scripts/mac-mini/nightly-verify.sh",
    "ops:mac-mini:validate-runtime": "bash scripts/mac-mini/validate-runtime-contract.sh --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@prisma/client": "^5.22.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.29",
    "node-fetch": "^2.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "json": "^11.0.0",
    "prisma": "^5.22.0",
    "prisma-erd-generator": "^2.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  }
}
